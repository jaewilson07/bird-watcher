# Copy this file to `.env` and fill in YOUR values.
# The .env file is gitignored — secrets never go on the internet.

# Lesson 2+ — IP address of the phone running the IP Webcam app
# (find it in the IP Webcam app once the server is started)
PHONE_IP=""

# Lesson 5 — Hugging Face token from https://huggingface.co/settings/tokens
HF_TOKEN=""

# Lesson 5 — where downloaded models get cached
HF_HOME="../data/models/"

# Lessons 7 & 10 — Slack incoming webhook URL
# Create the app from setup/slack-manifest.yml, install it, copy the URL here.
# (leave empty to run in dry-run mode: messages print instead of send)
SLACK_WEBHOOK=""

# Lesson 11 — Slack bot (Socket Mode). From api.slack.com/apps:
#   SLACK_BOT_TOKEN: OAuth & Permissions -> Bot User OAuth Token (xoxb-...)
#   SLACK_APP_TOKEN: Basic Information -> App-Level Tokens, with the
#                    connections:write scope (xapp-...)
SLACK_BOT_TOKEN=""
SLACK_APP_TOKEN=""

# Lesson 11 — base URL the bot puts in its "see your gallery" reply links
GALLERY_URL="http://localhost:8123"
